# Copy to pakka/.env (gitignored) and fill in ONE of the two Gemini options below.

# --- Option A: Gemini API key from Google AI Studio (quickest) -----------------------------
# aistudio.google.com -> Get API key. Pick the Google Cloud project whose billing account has
# your credits so usage is billed there.
GEMINI_API_KEY=

# --- Option B: Vertex AI on your Google Cloud project (spends Google Cloud credits) ---------
# Needs: gcloud CLI, `gcloud auth application-default login`, and the Vertex AI API enabled:
#   gcloud services enable aiplatform.googleapis.com --project YOUR_PROJECT_ID
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# The model the eval measured. Quote numbers only for the model you demo.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary is out of quota or overloaded (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
# Days before checks, photos and voice notes are deleted (DPDP: keep only as long as needed).
PAKKA_RETENTION_DAYS=180

# 1 = canned answers, no API calls. Use as the offline demo fallback.
PAKKA_MOCK=0
# Optional locally, required on Cloud Run: testers enter it once in the web app.
PAKKA_ACCESS_KEY=
# Max checks per IP per 10 minutes.
PAKKA_RATE_LIMIT=20
# 1 = allow POST /api/demo/reset (wipes records). Demo deployments only.
PAKKA_DEMO_RESET=1
